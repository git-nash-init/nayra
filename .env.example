# ========================================================
# NAYRA Official Website - Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. Client-Side Public Variables (Exposed in Vite Bundle)
# Prefix with VITE_ to allow frontend access
# --------------------------------------------------------

# Payment Gateway Key ID (e.g. Razorpay Key ID, Cashfree App ID, or Stripe Publishable Key)
# DO NOT place secret keys here! Only publishable/public client keys.
VITE_PAYMENT_GATEWAY_KEY_ID=rzp_test_your_key_id_here

# Public support email for customer inquiries
VITE_PUBLIC_SUPPORT_EMAIL=support@nayra.vip

# Public Telegram handle for community links
VITE_PUBLIC_TELEGRAM_HANDLE=@nayra_official


# --------------------------------------------------------
# 2. Server-Side Private Secrets (Backend / Webhook Only)
# NEVER EXPOSE THESE IN FRONTEND FILES OR CLIENT .ENV!
# These must only exist on your secure serverless/Node webhook handler.
# --------------------------------------------------------

# Payment Gateway Secret Key (Used server-side to verify webhook payment signatures)
# PAYMENT_GATEWAY_KEY_SECRET=your_backend_secret_key_here

# Telegram Bot Token (Used server-side to generate single-use private channel invite links)
# TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Telegram Private Channel Chat ID (The numeric ID of Nayra's private Telegram channel)
# TELEGRAM_PRIVATE_CHANNEL_ID=-1001234567890
